me":"text","type":"STRING","links":[27,30]},{"localized_name":"report","name":"report","type":"STRING","links":[28]},{"localized_name":"diff","name":"diff","type":"STRING","links":[29]}],"title":"LyricPatchTranscript (rapidfuzz)","properties":{"Node name for S&R":"LyricPatchTranscript"},"widgets_values":["",55],"widgets_values_named":{"lyrics":"","min_score":55}},{"id":71,"type":"PreviewAny","pos":[2547.411758780059,359.58979290696715],"size":[340,162],"flags":{},"order":24,"mode":0,"inputs":[{"localized_name":"source","name":"source","type":"*","link":27}],"outputs":[{"localized_name":"STRING","name":"STRING","type":"STRING","links":null}],"title":"patched text","properties":{"cnr_id":"comfy-core","ver":"0.34.2","Node name for S&R":"PreviewAny"},"widgets_values":[],"widgets_values_named":{}},{"id":72,"type":"PreviewAny","pos":[2547.8322822191203,591.1719859224876],"size":[340,162],"flags":{},"order":26,"mode":0,"inputs":[{"localized_name":"source","name":"source","type":"*","link":28}],"outputs":[{"localized_name":"STRING","name":"STRING","type":"STRING","links":null}],"title":"report (says so when it REFUSES)","properties":{"cnr_id":"comfy-core","ver":"0.34.2","Node name for S&R":"PreviewAny"},"widgets_values":[],"widgets_values_named":{}},{"id":73,"type":"PreviewAny","pos":[2553.6895636054287,825.9872890977274],"size":[340,162],"flags":{},"order":27,"mode":0,"inputs":[{"localized_name":"source","name":"source","type":"*","link":29}],"outputs":[{"localized_name":"STRING","name":"STRING","type":"STRING","links":null}],"title":"diff","properties":{"cnr_id":"comfy-core","ver":"0.34.2","Node name for S&R":"PreviewAny"},"widgets_values":[],"widgets_values_named":{}},{"id":74,"type":"SaveText","pos":[2549.753306765545,1051.3353697388009],"size":[340,226],"flags":{},"order":25,"mode":4,"inputs":[{"localized_name":"text","name":"text","type":"STRING","link":30},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null},{"localized_name":"format","name":"format","type":"COMBO","widget":{"name":"format"},"link":null}],"outputs":[{"localized_name":"text","name":"text","type":"STRING","links":null}],"title":"save the patched text","properties":{"cnr_id":"comfy-core","ver":"0.34.2","Node name for S&R":"SaveText"},"widgets_values":["lyric_align/patched","txt"],"widgets_values_named":{"filename_prefix":"lyric_align/patched","format":"txt"}},{"id":90,"type":"MarkdownNote","pos":[40,426.3088986302335],"size":[408.171875,495.5625],"flags":{},"order":4,"mode":0,"inputs":[],"outputs":[],"title":"READ ME - the five nodes","properties":{},"widgets_values":["### comfyui_lyric_align - what each node is for\n\n**`LyricsLoadFile`** reads the ground-truth sheet. Relative paths resolve against `ComfyUI/input/`.\n\n**`LyricForcedAlign`** (route A) force-aligns those known lyrics onto the audio with\n`torchaudio.pipelines.MMS_FA`. Feed it the WHOLE track and the isolated VOCAL - not a clip, not\nthe full mix. `chunk_seconds 60` for a full song; wav2vec2 attention is quadratic in length.\nOnly `a-z` and `'` align - digits, punctuation and accents are stripped before alignment, kept in\nthe output text, and get no timestamp of their own.\n\n**`LyricSliceByTime`** turns the alignment into \"what is sung between T and T+D\". Repetition is\nno longer ambiguous, because the answer is chosen by TIME. `min_overlap` (0.3 s) stops a line\nthat barely clips the window edge from being counted.\n\n**`LyricPatchTranscript`** (route B) repairs a transcript against the sheet with rapidfuzz. Text\nonly, instant, no model - but it matches on text alone, so a repeated chorus can match the wrong\ncopy. Below `min_score` it returns the transcript UNCHANGED; that refusal is designed behaviour,\nnot a failure.\n\n**`LyricVocalPresence`** measures whether anyone is singing: vocal in, instrumental as\n`reference`, out comes `has_vocal`. Use the RATIO, not an absolute level - a quiet sung intro and\na silent passage sit at nearly the same absolute dB, while vocal-minus-instrumental separates\nthem widely (sung -1..+4 dB, non-sung -21..-9 dB). `threshold_db -5` is the midpoint of that gap.\n\n**Confidence scores mislead here.** Median ~0.19 on sung vocals, because MMS_FA is a **speech** model."],"widgets_values_named":{"text":"### comfyui_lyric_align - what each node is for\n\n**`LyricsLoadFile`** reads the ground-truth sheet. Relative paths resolve against `ComfyUI/input/`.\n\n**`LyricForcedAlign`** (route A) force-aligns those known lyrics onto the audio with\n`torchaudio.pipelines.MMS_FA`. Feed it the WHOLE track and the isolated VOCAL - not a clip, not\nthe full mix. `chunk_seconds 60` for a full song; wav2vec2 attention is quadratic in length.\nOnly `a-z` and `'` align - digits, punctuation and accents are stripped before alignment, kept in\nthe output text, and get no timestamp of their own.\n\n**`LyricSliceByTime`** turns the alignment into \"what is sung between T and T+D\". Repetition is\nno longer ambiguous, because the answer is chosen by TIME. `min_overlap` (0.3 s) stops a line\nthat barely clips the window edge from being counted.\n\n**`LyricPatchTranscript`** (route B) repairs a transcript against the sheet with rapidfuzz. Text\nonly, instant, no model - but it matches on text alone, so a repeated chorus can match the wrong\ncopy. Below `min_score` it returns the transcript UNCHANGED; that refusal is designed behaviour,\nnot a failure.\n\n**`LyricVocalPresence`** measures whether anyone is singing: vocal in, instrumental as\n`reference`, out comes `has_vocal`. Use the RATIO, not an absolute level - a quiet sung intro and\na silent passage sit at nearly the same absolute dB, while vocal-minus-instrumental separates\nthem widely (sung -1..+4 dB, non-sung -21..-9 dB). `threshold_db -5` is the midpoint of that gap.\n\n**Confidence scores mislead here.** Median ~0.19 on sung vocals, because MMS_FA is a **speech** model."},"color":"#432","bgcolor":"#653"},{"id":94,"type":"LyricPatchTranscript","pos":[3009.286866051624,89.44567177250894],"size":[340,218],"flags":{},"order":23,"mode":0,"inputs":[{"localized_name":"transcript","name":"transcript","type":"STRING","link":37},{"localized_name":"lyrics","name":"lyrics","type":"STRING","widget":{"name":"lyrics"},"link":38},{"localized_name":"min_score","name":"min_score","shape":7,"type":"FLOAT","widget":{"name":"min_score"},"link":null}],"outputs":[{"localized_name":"text","name":"text","type":"STRING","links":[33,36]},{"localized_name":"report","name":"report","type":"STRING","links":[34]},{"localized_name":"diff","name":"diff","type":"STRING","links":[35]}],"title":"LyricPatchTranscript (rapidfuzz)","properties":{"Node name for S&R":"LyricPatchTranscript"},"widgets_values":["",20],"widgets_values_named":{"lyrics":"","min_score":20}},{"id":95,"type":"PreviewAny","pos":[3014.834626441757,372.20376801500913],"size":[340,162],"flags":{},"order":28,"mode":0,"inputs":[{"localized_name":"source","name":"source","type":"*","link":33}],"outputs":[{"localized_name":"STRING","name":"STRING","type":"STRING","links":null}],"title":"patched text","properties":{"cnr_id":"comfy-core","ver":"0.34.2","Node name for S&R":"PreviewAny"},"widgets_values":[],"widgets_values_named":{}},{"id":96,"type":"PreviewAny","pos":[3015.255149880818,603.7859610305302],"size":[340,162],"flags":{},"order":30,"mode":0,"inputs":[{"localized_name":"source","name":"source","type":"*","link":34}],"outputs":[{"localized_name":"STRING","name":"STRING","type":"STRING","links":null}],"title":"report (says so when it REFUSES)","properties":{"cnr_id":"comfy-core","ver":"0.34.2","Node name for S&R":"PreviewAny"},"widgets_values":[],"widgets_values_named":{}},{"id":97,"type":"PreviewAny","pos":[3021.1124312671263,838.60126420577],"size":[340,162],"flags":{},"order":31,"mode":0,"inputs":[{"localized_name":"source","name":"source","type":"*","link":35}],"outputs":[{"localized_name":"STRING","name":"STRING","type":"STRING","links":null